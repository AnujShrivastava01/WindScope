# ---------------------------------------------------------------------------
# WindScope configuration. Copy to `.env` and adjust. No secrets are required:
# the Elexon Insights (BMRS) API used here is public and needs no API key.
# ---------------------------------------------------------------------------

# --- Backend (FastAPI) ---
APP_ENV=development
LOG_LEVEL=INFO
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=3
ELEXON_BACKOFF_SECONDS=1.0
ELEXON_CHUNK_DAYS=7
# SQLite file; mounted on a named volume in docker compose.
DATABASE_PATH=./data/windscope.db
# Comma-separated browser origins allowed by CORS (add your Vercel URL in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional regex, e.g. to allow Vercel preview deployments: ^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=
# Procurement decision window (UK local dates, inclusive).
DECISION_DATE_START=2026-01-01
DECISION_DATE_END=2026-01-31
# Assumed day-ahead decision cutoff (UK local time) and day offset (D-n). Analysis assumption only.
DEFAULT_CUTOFF_TIME=10:00
DEFAULT_CUTOFF_DAYS_BEFORE=1
# Fetch data from Elexon automatically when the store is empty.
AUTO_INGEST_ON_STARTUP=true
# A dataset is flagged stale if its last successful API refresh is older than this.
STALE_AFTER_HOURS=24

# --- Frontend (Vite) ---
# Base URL of the backend API as seen by the browser. Leave empty to use same-origin /api
# (the Vite dev server and the nginx container both proxy /api to the backend).
VITE_API_BASE_URL=
